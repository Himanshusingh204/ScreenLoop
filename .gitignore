# ─────────────────────────────────────────────────────────────────────────────
# Root .gitignore — Screenloop Repository
# Prevents sensitive credentials, environment variables, logs and build artifacts
# from being committed to GitHub.
# ─────────────────────────────────────────────────────────────────────────────

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Production Build Outputs
dist/
build/
.output/
.vercel/

# Environment Variables & Secrets (CRITICAL: NEVER COMMIT SECRETS)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.*
!.env.example
client/.env
client/.env.local
server/.env
server/.env.local

# Operating System & IDE Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs & Temporary Files
logs/
*.log
*.tmp
*.bak
.gemini/
.agents/

# Private Docs
GIT_CHEATSHEET.md
AI_OVERVIEW.md
