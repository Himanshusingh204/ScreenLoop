PORT=4000
ALLOWED_ORIGIN=http://localhost:5173

# Room capacity / lifecycle
MAX_PARTICIPANTS=10
MAX_MEET_PARTICIPANTS=20
MAX_ROOMS=100
ROOM_TTL_MS=1800000
# Idle TTL for video meets (defaults to ROOM_TTL_MS when unset)
MEET_TTL_MS=1800000

# Rate limiting / brute-force protection
SPAM_MAX_EVENTS=20
PIN_MAX_ATTEMPTS=5

# Logging
LOG_LEVEL=info

# LiveKit SFU Credentials
# Sign up free at cloud.livekit.io or use local/self-hosted LiveKit instance
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Room listing endpoint (/api/rooms). Dev default: on. Prod default: off.
# Set to true only if you need a public lobby; otherwise leave disabled.
ROOM_LISTING_ENABLED=false
