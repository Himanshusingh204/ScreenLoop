# Client Environment Variables

# URL of your signaling server (canonical — used by both /room and /meet)
# Local development:
VITE_SERVER_URL=http://localhost:4000
# Production (after deploying backend to Render/Railway):
# VITE_SERVER_URL=https://your-server.onrender.com

# LiveKit SFU WebSocket URL (provided by LiveKit Cloud or self-hosted instance)
# VITE_LIVEKIT_URL=wss://your-project.livekit.cloud

# Deprecated alias (meet only) — still honored as fallback, remove after migration:
# VITE_SIGNALING_URL=https://your-server.onrender.com

# Optional TURN configuration (recommended for production so calls work
# behind symmetric NATs). Comma-separated TURN URLs + shared credential.
# If unset: dev falls back to public OpenRelay; prod uses STUN-only with a warning.
# VITE_TURN_URLS=turn:your-turn-host:3478,turns:your-turn-host:5349
# VITE_TURN_USERNAME=screenloop
# VITE_TURN_CREDENTIAL=replace-me
